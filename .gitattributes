# 默认：自动识别文本文件，仓库内统一使用 LF
* text=auto eol=lf

# 明确文本类型
*.md text
*.txt text
*.json text
*.js text
*.jsx text
*.ts text
*.tsx text
*.vue text
*.css text
*.html text
*.yml text
*.yaml text
*.py text
*.java text
*.go text
*.rs text
*.sql text
*.sh text eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary

# 语言统计时排除
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
yarn.lock linguist-generated=true
